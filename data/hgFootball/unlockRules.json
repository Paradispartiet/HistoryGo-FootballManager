{
  "schema": "history-go.hg-football.unlock-rules.v1",
  "version": 1,
  "unlockPrinciples": [
    "Spilleren kan bare bruke fotballspillere fra steder de har besøkt/låst opp i History Go.",
    "Spillere fra klubber/steder man ikke har samlet, er ikke tilgjengelige i laget.",
    "Formasjoner kan låses opp via epoke, klubb, stadion, trener, historisk spiller, sportssted eller Groundhopper-relasjon.",
    "Staff låses opp via klubbsteder.",
    "Verdensberømte stadioner kan fungere som sportssteder i History Go og samtidig være Groundhopper-relevante steder.",
    "Sportkategorien brukes for fotballstadioner, klubbanlegg, baner, arenaer og relevante idrettssteder.",
    "Parker flyttes ikke til sport bare fordi man kan trene der; fotball-/stadion-/klubbspesifikke steder går i sport.",
    "Hvis en unlock senere endrer brukerens progression i runtime, må koden dispatche window-eventet 'updateProfile'. Denne oppgaven implementerer ikke runtime-kode."
  ],
  "unlockSources": [
    { "id": "history_go_place", "name": "History Go-sted", "summary": "Et hvilket som helst besøkt/samlet sted i History Go." },
    { "id": "sport_place", "name": "Sportssted", "summary": "Sted i sportkategorien: stadion, klubbanlegg, bane, arena." },
    { "id": "football_stadium", "name": "Fotballstadion", "summary": "Stadion, ofte både sportssted og Groundhopper-relevant." },
    { "id": "football_club", "name": "Fotballklubb", "summary": "Klubbsted som binder spillere og staff." },
    { "id": "groundhopper_place", "name": "Groundhopper-sted", "summary": "Bane/stadion relevant for Groundhopper-relasjoner." },
    { "id": "collected_player", "name": "Samlet spiller", "summary": "Spiller låst opp gjennom History Go." },
    { "id": "collected_manager", "name": "Samlet trener", "summary": "Trener/manager låst opp gjennom History Go." },
    { "id": "collected_staff", "name": "Samlet staff", "summary": "Staff låst opp gjennom klubbsteder." },
    { "id": "football_story", "name": "Fotballhistorie", "summary": "Historisk story som låser opp epoke/system." },
    { "id": "football_lexicon_entry", "name": "Fotballeksikon-oppslag", "summary": "Leksikonoppslag som låser opp taktisk kunnskap." },
    { "id": "football_badge", "name": "Fotballbadge", "summary": "Badge som markerer oppnådd kunnskap/relasjon." }
  ],
  "unlockTiers": ["start", "early", "standard", "advanced"],
