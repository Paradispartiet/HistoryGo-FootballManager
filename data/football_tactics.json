    {
      "id": "kontroll",
      "name": "Kontroll",
      "summary": "Ha ballen, styr tempoet, bryt dem ned tålmodig.",
      "risk": "Mister du ballen høyt, ligger rommet bak åpent."
    },
    {
      "id": "press",
      "name": "Press",
      "summary": "Vinn ballen høyt og angrip før de er organisert.",
      "risk": "Krever kondisjon og samtidighet. Brytes pressen, er du utspilt."
    },
    {
      "id": "kontring",
      "name": "Kontring",
      "summary": "Gi dem ballen, hold formen, straff dem i overgangen.",
      "risk": "Du overlater initiativet. Scorer de først, må planen byttes."
    },
    {
      "id": "direkte",
      "name": "Direkte",
      "summary": "Kort vei fram, andreballer og press på deres siste linje.",
